<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 1: formulario con los datos del usuario -->
<!-- LinearLayout vertical: coloca los elementos uno debajo del otro -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_ficha"
        android:textSize="22sp" />

    <!-- Nombre -->
    <TextView
        android:id="@+id/txtLabelNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_nombre" />

    <EditText
        android:id="@+id/edtNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName" />

    <!-- Apellidos -->
    <TextView
        android:id="@+id/txtLabelApellidos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_apellidos" />

    <EditText
        android:id="@+id/edtApellidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName" />

    <!-- Edad: inputType="number" hace que salga el teclado numérico
         y maxLength="3" no deja escribir más de 3 cifras -->
    <TextView
        android:id="@+id/txtLabelEdad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_edad" />

    <EditText
        android:id="@+id/edtEdad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:maxLength="3" />

    <!-- Matriculado -->
    <TextView
        android:id="@+id/txtLabelMatriculado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_matriculado" />

    <!-- RadioGroup agrupa los RadioButton: así solo se puede marcar uno -->
    <RadioGroup
        android:id="@+id/rgMatriculado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opcion_si" />

        <RadioButton
            android:id="@+id/rbNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opcion_no" />
    </RadioGroup>

    <Button
        android:id="@+id/btnMostrarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_mostrar_info" />

    <!-- Aquí se muestra si se ha aceptado la política al volver de la pantalla 2 -->
    <TextView
        android:id="@+id/txtPrivacidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/privacidad_pendiente" />

</LinearLayout>
